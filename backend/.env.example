ENVIRONMENT=development
DEBUG=true
APP_TITLE=FastAPI Template
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

EXPOSE_APP_PORT=8201

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app

CORS_ORIGINS=http://localhost:5173

# Тесты с БД (make test-infra): отдельная база (имя оканчивается на _test); хост и порт по умолчанию из POSTGRES_*
TEST_POSTGRES_DB=app_test
