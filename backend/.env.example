ENVIRONMENT=development
DEBUG=true
APP_TITLE=FastAPI Template
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

EXPOSE_APP_PORT=8201

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app

CORS_ORIGINS=http://localhost:5173

# Секрет подписи JWT (HS256, не хранится, не настраивается алгоритм). Обязателен и должен быть случайным (>= 32
# символов) вне development; в development есть небезопасный дефолт для удобства.
JWT_SECRET=dev-only-secret-do-not-use-in-production-1234
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE=              # bool; по умолчанию включено вне development
# COOKIE_DOMAIN=              # например .example.com; по умолчанию не задан (host-only cookie)
COOKIE_SAMESITE=lax           # lax | strict | none (none требует COOKIE_SECURE=true)
REGISTRATION_ENABLED=false
SEEDING_ENABLED=true

# Тесты с БД (make test-infra): отдельная база (имя оканчивается на _test); хост и порт по умолчанию из POSTGRES_*
TEST_POSTGRES_DB=app_test
# TEST_POSTGRES_HOST=localhost
# TEST_POSTGRES_PORT=5432
